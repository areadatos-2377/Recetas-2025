# Cadena de conexion a Postgres (en Railway la provee el plugin de PostgreSQL)
DATABASE_URL=postgres://usuario:password@localhost:5432/captura_unidades

# Poner en "true" solo si la conexion a Postgres exige SSL (algunos proveedores externos lo requieren; Railway en red interna no)
PGSSL=false

# Cadena larga y aleatoria usada para firmar la cookie de sesion (JWT)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# En produccion (HTTPS) debe ser "true" para que la cookie de sesion solo viaje por HTTPS
COOKIE_SECURE=false

# URL de la implementacion del Google Apps Script (Web App) que sube el Excel a Drive
DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec

# Token secreto compartido entre este backend y el Apps Script (debe coincidir con el configurado alla)
DRIVE_WEBHOOK_TOKEN=cambia-esto-por-otro-secreto-compartido

PORT=3000
